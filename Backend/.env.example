# Copy to .env (never commit .env). Lines starting with # are defaults.

# ---- Server ----
HOST=0.0.0.0
PORT=8001

# ---- LLM (Ollama) ----
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434

# ---- Voice emotion (Week 3 Day 2-3) ----
# needs models/ssl_wavlm-large-adapted_emotion.joblib (not in git)
EMOTION_MODEL=wavlm-large-adapted
# voice guesses below this confidence are shown as neutral
EMOTION_MIN_CONFIDENCE=0.6
# EMOTION_MODEL_DIR=models
# EMOTION_THREADS=4

# ---- Text emotion + fusion (Week 3 Day 5, Week 4) ----
# TEXT_EMOTION=1                        # 0 = voice-only emotion
# TEXT_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
# TEXT_NEUTRAL_STRONG=0.75              # clearly neutral words keep plain questions neutral
# VOICE_DISGUST_MIN=0.9                 # voice-only "disgust" must be this sure (over-predicted live)
# VOICE_BASELINE=1                      # learn how the model hears YOUR normal voice, judge the change
# VOICE_BASELINE_TURNS=2                # neutral-word turns before the baseline is used
# VOICE_BASELINE_STRENGTH=0.7           # 0 = off, 1 = full correction

# ---- End of speech (VAD) ----
# VAD_SILENCE_MS=700                    # silence before Auralis answers; 500 = ~200 ms faster,
#                                       # but long sentences may get split at pauses

# ---- Whisper speech-to-text (Week 3 Day 6) ----
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=auto                   # auto | cpu | cuda  (auto = GPU if usable)
# WHISPER_COMPUTE_TYPE=                 # default: float16 on GPU, int8 on CPU
# WHISPER_BEAM_SIZE=5                   # 1 = faster, slightly less accurate
# GPU on Windows also needs:  python -m pip install --no-cache-dir nvidia-cublas-cu12 "nvidia-cudnn-cu12==9.*"

# ---- Piper text-to-speech (Week 3 Day 3-4) ----
# TTS_VOICE=models/tts/en_US-lessac-medium.onnx
# TTS_FIRST_CLAUSE_CHARS=20             # first spoken piece may end at a comma (0 = full sentence)

# ---- Barge-in / interruption (Week 4) ----
# BARGE_IN=1                            # 0 = old behaviour (speech over Auralis = echo, ignored)
# BARGE_IN_MIN_VOICED_FRAMES=20         # real-voice frames (x 20 ms) before Auralis stops,
#                                       # used until the user's speaking level is learned
# BARGE_IN_GATE_DB=5                    # then: only frames at most 5 dB below the user's level
#                                       # count (Auralis's echo is quieter). 0 = gate off
# BARGE_IN_GATED_FRAMES=10              # loud frames needed with the gate (10 x 20 ms)
#                                       # raise both if Auralis stops on its own speaker echo

# ---- Logs ----
# LATENCY_LOG=1                         # per-turn latency breakdown -> logs/latency.csv

# ---- Deployment (hybrid: Vercel frontend + this laptop via Cloudflare Tunnel) ----
# CORS_ORIGINS=https://your-app.vercel.app      # comma-separated, no trailing /
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=                                 # from the Metered dashboard (never commit)
# TURN_CREDENTIAL=
