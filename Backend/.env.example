PORT=8001

# ---- Emotion (Week 3 Day 3-5) ----
# EMOTION_MODEL=wavlm-large-adapted     # needs models/ssl_wavlm-large-adapted_emotion.joblib
# EMOTION_MIN_CONFIDENCE=0.6
# TEXT_EMOTION=1                        # 0 = voice-only emotion

# ---- Whisper speech-to-text (Week 3 Day 6) ----
# WHISPER_MODEL=base.en
# WHISPER_DEVICE=auto                   # auto | cpu | cuda  (auto = GPU if usable)
# WHISPER_COMPUTE_TYPE=                 # default: float16 on GPU, int8 on CPU
# WHISPER_BEAM_SIZE=5                   # 1 = faster on CPU, slightly less accurate
#
# GPU on Windows also needs:  python -m pip install nvidia-cublas-cu12 "nvidia-cudnn-cu12==9.*"
